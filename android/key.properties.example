# Template Konfigurasi Keystore Rilis Android FitTrace
# Copy file ini menjadi `key.properties` di folder `android/`
# Jangan pernah meng-commit file `key.properties` atau file `.jks` ke git repository!
#
# Untuk membuat keystore baru:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=password_keystore_anda
keyPassword=password_key_anda
keyAlias=upload
storeFile=upload-keystore.jks

